          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404 Not Found', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test('Error code is NOT_FOUND', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.error.code).to.eql('NOT_FOUND');",
