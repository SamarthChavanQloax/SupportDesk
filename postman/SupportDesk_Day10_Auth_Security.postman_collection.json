    {
      "name": "AUTH-15: Agent Ticket Visibility (Views All Tickets)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Agent sees full ticket inventory (50 tickets)', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.meta.total).to.be.at.least(50);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
