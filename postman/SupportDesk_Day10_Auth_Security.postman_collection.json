{
  "info": {
    "_postman_id": "day10-auth-security-collection-2026",
    "name": "SupportDesk — Day 10 Auth & Security Testing",
    "description": "Automated Postman test suite verifying Day 10 authentication, password hashing, JWT authorization, RBAC, ticket ownership, Helmet, CORS, and rate limiting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "AUTH-19: Helmet Security Headers & GET /health",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Helmet headers are present', function () {",
              "    pm.response.to.have.header('x-content-type-options');",
              "    pm.response.to.have.header('x-frame-options');",
              "});",
              "pm.test('Standard response envelope verified', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('data');",
              "    pm.expect(json).to.have.property('error', null);",
              "    pm.expect(json).to.have.property('meta');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "AUTH-17: CORS Allowlist Check (Approved Origin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('CORS Access-Control-Allow-Origin matches approved origin', function () {",
              "    pm.expect(pm.response.headers.get('access-control-allow-origin')).to.eql('http://localhost:5173');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "http://localhost:5173",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "AUTH-01: Register Valid Customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Safe user returned with default customer role', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data).to.have.property('id');",
              "    pm.expect(json.data.role).to.eql('customer');",
              "    pm.expect(json.data).to.not.have.property('passwordHash');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Asha Customer\",\n  \"email\": \"asha.customer.day10@example.test\",\n  \"password\": \"ExampleOnly!234\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "AUTH-02: Duplicate Registration Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 409 Conflict', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test('Error code is CONFLICT', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.error.code).to.eql('CONFLICT');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Asha Duplicate\",\n  \"email\": \"asha.customer.day10@example.test\",\n  \"password\": \"ExampleOnly!234\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "AUTH-03: Invalid Registration Input (Short Password)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Validation error code returned', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.error.code).to.eql('VALIDATION_ERROR');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"A\",\n  \"email\": \"invalid-email\",\n  \"password\": \"short\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "AUTH-05: Login Valid Customer Credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('JWT accessToken and safe user details returned', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data).to.have.property('accessToken');",
              "    pm.expect(json.data.user.email).to.eql('alice.customer@example.com');",
              "    pm.environment.set('customerToken', json.data.accessToken);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice.customer@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "AUTH-05b: Login Valid Agent Credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Agent accessToken returned with agent role', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data).to.have.property('accessToken');",
              "    pm.expect(json.data.user.role).to.eql('agent');",
              "    pm.environment.set('agentToken', json.data.accessToken);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"dave.agent@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
