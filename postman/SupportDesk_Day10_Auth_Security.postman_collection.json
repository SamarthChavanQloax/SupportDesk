        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice.customer@example.com\",\n  \"password\": \"WrongPassword999!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
