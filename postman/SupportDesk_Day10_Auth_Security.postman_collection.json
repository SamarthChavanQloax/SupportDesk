              "    pm.response.to.have.status(401);",
              "});",
              "pm.test('Generic error message returned', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.error.message).to.eql('Invalid email or password');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
