      "response": []
    },
    {
      "name": "Test 5: PATCH /tickets/:id (Step 3 - Update Ticket)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Updated fields match PATCH payload and unmodified fields persist', function () {",
              "    const body = pm.response.json();",
              "    const expectedId = pm.environment.get('ticketId');",
              "    ",
              "    pm.expect(body.data.id).to.eql(expectedId);",
              "    pm.expect(body.data.title).to.eql('Postman E2E Test Ticket: VPN Gateway Resolved (Title Updated)');",
              "    pm.expect(body.data.status).to.eql('in_progress');",
              "    pm.expect(body.data.priority).to.eql('P1');",
              "    pm.expect(body.data.description).to.eql('Remote employees unable to authenticate via OpenVPN gateway.');",
              "    ",
              "    pm.environment.set('updatedTitle', body.data.title);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
