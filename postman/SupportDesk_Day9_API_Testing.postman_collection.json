  "item": [
    {
      "name": "Test 1: GET /health",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has standard envelope structure', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('data');",
              "    pm.expect(body).to.have.property('error');",
              "    pm.expect(body).to.have.property('meta');",
              "    pm.expect(body.error).to.be.null;",
              "});",
              "",
              "pm.test('Health status is ok with valid service metadata', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.data.status).to.eql('ok');",
              "    pm.expect(body.data.service).to.eql('SupportDesk API');",
              "    pm.expect(body.data).to.have.property('timestamp');",
              "    pm.expect(body.data).to.have.property('uptime');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "response": []
    },
