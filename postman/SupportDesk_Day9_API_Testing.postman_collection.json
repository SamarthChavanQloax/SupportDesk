    {
      "name": "Test 3: POST /tickets (Step 1 - Create Ticket)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has standard structure and error is null', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('data');",
              "    pm.expect(body.error).to.be.null;",
              "});",
              "",
              "pm.test('Created ticket contains valid ID, reference, and timestamps', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.data).to.have.property('id');",
              "    pm.expect(body.data.id).to.be.a('number');",
              "    pm.expect(body.data).to.have.property('reference');",
              "    pm.expect(body.data.reference).to.match(/^TCK-\\d{4}-/);",
              "    pm.expect(body.data.title).to.eql('Postman E2E Test Ticket: VPN Authentication Failure');",
              "    pm.expect(body.data.status).to.eql('open');",
              "    pm.expect(body.data.priority).to.eql('P2');",
              "    ",
              "    // Save dynamic environment variables for subsequent tests",
              "    pm.environment.set('ticketId', body.data.id);",
              "    pm.environment.set('ticketRef', body.data.reference);",
              "    pm.environment.set('createdTitle', body.data.title);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman E2E Test Ticket: VPN Authentication Failure\",\n  \"description\": \"Remote employees unable to authenticate via OpenVPN gateway.\",\n  \"customerId\": 1,\n  \"priority\": \"P2\",\n  \"status\": \"open\",\n  \"category\": \"Networking\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tickets",
          "host": ["{{baseUrl}}"],
          "path": ["tickets"]
        }
      },
      "response": []
    },
    {
      "name": "Test 4: GET /tickets/:id (Step 2 - Retrieve Created Ticket)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Retrieved ticket matches submitted creation data', function () {",
              "    const body = pm.response.json();",
              "    const expectedId = pm.environment.get('ticketId');",
              "    const expectedRef = pm.environment.get('ticketRef');",
              "    const expectedTitle = pm.environment.get('createdTitle');",
              "    ",
              "    pm.expect(body.data.id).to.eql(expectedId);",
              "    pm.expect(body.data.reference).to.eql(expectedRef);",
              "    pm.expect(body.data.title).to.eql(expectedTitle);",
              "    pm.expect(body.data.status).to.eql('open');",
              "    pm.expect(body.data.priority).to.eql('P2');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tickets", "{{ticketId}}"]
