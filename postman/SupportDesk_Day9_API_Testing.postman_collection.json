    {
      "name": "Test 11: GET /test/error (Controlled 500 Error Handler Test)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 500 Internal Server Error', function () {",
              "    pm.response.to.have.status(500);",
              "});",
              "",
              "pm.test('Response does not leak stack traces or internal secrets', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.data).to.be.null;",
              "    pm.expect(body.error.code).to.eql('INTERNAL_SERVER_ERROR');",
              "    pm.expect(body.error.message).to.eql('An unexpected error occurred. Please try again later.');",
              "    pm.expect(body).to.not.have.property('stack');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
