# SupportDesk environment configuration
# Examples only. Replace placeholders locally when configuration is approved.
# Never commit real credentials or secrets.

# API
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/supportdesk

# Frontend
VITE_API_BASE_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
